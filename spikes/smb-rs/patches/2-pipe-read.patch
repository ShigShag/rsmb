+
+    /// Reads up to `length` bytes from the pipe, e.g. the rest of an RPC reply after
+    /// FSCTL_PIPE_TRANSCEIVE returned STATUS_BUFFER_OVERFLOW.
+    pub async fn read(&self, length: u32) -> crate::Result<Vec<u8>> {
+        let request = ReadRequest {
+            flags: Default::default(),
+            length,
+            offset: 0,
+            file_id: self.handle.file_id()?,
+            minimum_count: 0,
+        };
+        let options = ReceiveOptions::new()
+            .with_allow_async(true)
+            .with_status(&[Status::Success, Status::BufferOverflow]);
+        let response = self.handle.send_recvo(request.into(), options).await?;
+        Ok(response.message.content.to_read()?.buffer)
+    }
